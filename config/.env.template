# CBR MCP Server Environment Variables Template
# Copy to .env and customize for your environment
#
# Usage:
#   cp .env.template .env
#   # Edit .env with your values
#   source .env && cbr-mcp-server
#
# Priority: Environment variables override YAML configuration

# =============================================================================
# CORE CBR CONFIGURATION
# =============================================================================

# Database Configuration
CBR_DATABASE_PATH=./db
CBR_COLLECTION_NAME=code_solutions_case_base
CBR_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# Query Defaults
CBR_MAX_RESULTS_DEFAULT=10
CBR_SIMILARITY_THRESHOLD_DEFAULT=0.7
CBR_ENABLE_HEALTH_CHECKS=true

# =============================================================================
# ENHANCED LOGGING SYSTEM
# =============================================================================

# Basic Logging
CBR_LOG_LEVEL=INFO
CBR_LOG_FORMAT=json
# CBR_LOG_FILE=./cbr_server.log

# Console Logging
CBR_LOG_CONSOLE=true
CBR_LOG_CONSOLE_FORMAT=text

# File Rotation
CBR_LOG_MAX_SIZE=10485760
CBR_LOG_BACKUP_COUNT=5
CBR_LOG_ROTATION=true
CBR_LOG_CLEANUP=true

# Advanced Logging Features  
CBR_LOG_COLORS=false
CBR_LOG_PERFORMANCE=true
CBR_LOG_CORRELATION=true
CBR_LOG_THREAD_SAFE=true

# Disk Space Monitoring
CBR_LOG_DISK_MONITORING=false
CBR_LOG_MIN_FREE_SPACE=10.0
CBR_LOG_HANDLE_PERMISSIONS=true

# =============================================================================
# SYSTEM RESOURCE MONITORING  
# =============================================================================

# Basic Monitoring
CBR_MONITORING_ENABLED=true
CBR_MONITORING_INTERVAL=30.0
CBR_MONITORING_DB_PATH=./monitoring.db
CBR_MONITORING_RETENTION_HOURS=168

# Alert Configuration
CBR_MONITORING_ALERT_COOLDOWN=300
CBR_MONITORING_MAX_ALERTS_PER_HOUR=100

# CPU Thresholds (percentages)
CBR_MONITORING_CPU_WARNING=70.0
CBR_MONITORING_CPU_CRITICAL=85.0
CBR_MONITORING_CPU_EMERGENCY=95.0

# Memory Thresholds (percentages)
CBR_MONITORING_MEMORY_WARNING=75.0
CBR_MONITORING_MEMORY_CRITICAL=90.0
CBR_MONITORING_MEMORY_EMERGENCY=98.0

# Disk Thresholds (percentages)
CBR_MONITORING_DISK_WARNING=80.0
CBR_MONITORING_DISK_CRITICAL=90.0
CBR_MONITORING_DISK_EMERGENCY=95.0

# =============================================================================
# HEALTH DASHBOARD
# =============================================================================

# Basic Dashboard Configuration
CBR_DASHBOARD_HOST=localhost
CBR_DASHBOARD_PORT=8080
CBR_DASHBOARD_DEBUG=false

# WebSocket Configuration
CBR_WEBSOCKET_ENABLED=true
CBR_METRICS_INTERVAL=5
CBR_DASHBOARD_MAX_CONNECTIONS=100

# Security
CBR_SECURITY_HEADERS=true
CBR_DASHBOARD_MAX_PAYLOAD_SIZE=1048576

# CORS Origins (comma-separated)
# CBR_DASHBOARD_CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# =============================================================================
# PRODUCTION FEATURES
# =============================================================================

# Authentication
CBR_REQUIRE_AUTH=false
# CBR_API_KEYS=key1,key2,key3
# CBR_ADMIN_KEYS=admin1,admin2

# Rate Limiting
CBR_RATE_LIMIT_ENABLED=true
CBR_RATE_LIMIT_REQUESTS=100
CBR_RATE_LIMIT_WINDOW=3600

# Performance Features
CBR_CACHE_ENABLED=true
CBR_CACHE_TTL=3600
CBR_PERFORMANCE_MONITORING=true

# Reliability Features
CBR_RETRY_ENABLED=true
CBR_MAX_RETRIES=3
CBR_CIRCUIT_BREAKER=true

# Input Validation
CBR_INPUT_VALIDATION=strict
CBR_SANITIZATION=true
CBR_MAX_QUERY_LENGTH=10000

# =============================================================================
# HEALTH CHECKS
# =============================================================================

CBR_HEALTH_ENABLED=true
CBR_HEALTH_TIMEOUT=30

# =============================================================================
# LEGACY/COMPATIBILITY SETTINGS
# =============================================================================

# Backward Compatibility
CBR_MONITORING_PORT=8080
CBR_LOG_CORRELATION_ID=true
CBR_USE_MOCK_DATA=false
CBR_HEALTH_CHECK_ENABLED=true
CBR_METRICS_ENABLED=true

# =============================================================================
# ENVIRONMENT-SPECIFIC EXAMPLES
# =============================================================================

# Development Environment
# Uncomment and modify for development use:
#
# CBR_LOG_LEVEL=DEBUG
# CBR_LOG_CONSOLE_FORMAT=colored  
# CBR_LOG_COLORS=true
# CBR_REQUIRE_AUTH=false
# CBR_RATE_LIMIT_ENABLED=false
# CBR_CACHE_ENABLED=false
# CBR_INPUT_VALIDATION=permissive
# CBR_DASHBOARD_DEBUG=true

# Production Environment
# Uncomment and modify for production use:
#
# CBR_DATABASE_PATH=/opt/cbr/data/db
# CBR_LOG_LEVEL=INFO
# CBR_LOG_FORMAT=json
# CBR_LOG_FILE=/var/log/cbr/server.log
# CBR_LOG_CONSOLE=false
# CBR_REQUIRE_AUTH=true
# CBR_API_KEYS=your-secure-key-1,your-secure-key-2
# CBR_ADMIN_KEYS=your-admin-key
# CBR_RATE_LIMIT_REQUESTS=500
# CBR_DASHBOARD_HOST=0.0.0.0
# CBR_MONITORING_RETENTION_HOURS=720

# Docker Container Environment
# Uncomment and modify for container deployment:
#
# CBR_DATABASE_PATH=/app/data/db
# CBR_LOG_CONSOLE=true
# CBR_LOG_CONSOLE_FORMAT=json
# CBR_LOG_FILE=""
# CBR_DASHBOARD_HOST=0.0.0.0
# CBR_MONITORING_DB_PATH=/app/data/monitoring.db
# CBR_REQUIRE_AUTH=true
# Load API keys from Docker secrets:
# CBR_API_KEYS_FILE=/run/secrets/cbr_api_keys
# CBR_ADMIN_KEYS_FILE=/run/secrets/cbr_admin_keys

# =============================================================================
# SECURITY CONSIDERATIONS
# =============================================================================

# IMPORTANT SECURITY NOTES:
#
# 1. API Keys:
#    - Never commit real API keys to version control
#    - Use long, randomly generated keys (32+ characters)
#    - Rotate keys regularly
#    - Consider using external secret management
#
# 2. File Permissions:
#    - Ensure .env file has restricted permissions (600)
#    - Database directory should be writable by service user only
#    - Log files should have appropriate permissions
#
# 3. Network Security:
#    - Use localhost for dashboard in production with reverse proxy
#    - Configure CORS origins appropriately
#    - Consider using HTTPS for dashboard access
#
# 4. Monitoring:
#    - Set conservative resource thresholds for production
#    - Monitor disk space for database and logs
#    - Set up external alerting for critical thresholds

# =============================================================================
# TROUBLESHOOTING VARIABLES
# =============================================================================

# Enable these for debugging configuration issues:
#
# CBR_CONFIG_VERBOSE=true
# CBR_STARTUP_DEBUG=true
# CBR_VALIDATION_STRICT=true

# =============================================================================
# USAGE EXAMPLES
# =============================================================================

# Load this file and start server:
# source .env && cbr-mcp-server
#
# Override specific values:
# CBR_LOG_LEVEL=DEBUG source .env && cbr-mcp-server
#
# Use with YAML config (env vars take precedence):
# source .env && cbr-mcp-server --config production.yaml
#
# Validate configuration:
# source .env && cbr-mcp-server --validate-only
#
# Test configuration:
# source .env && cbr-mcp-server --dry-run

# Note: Remove or comment out variables you don't need to override.
# The server will use sensible defaults for any unset variables.